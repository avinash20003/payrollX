
# Copy to .env and replace every CHANGE_ME value with a unique secret.
POSTGRES_DB=payrollx_salary
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
APP_DB_USER=payrollx_app
APP_DB_PASSWORD=CHANGE_ME_URL_SAFE_APP_DB_PASSWORD
MIGRATOR_DB_USER=payrollx_migrator
MIGRATOR_DB_PASSWORD=CHANGE_ME_MIGRATOR_PASSWORD
ADMIN_USERNAME=Administrator
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD_AT_LEAST_12_CHARACTERS

# Existing installations must point this at the volume containing their data.
# The deployment script refuses to guess when it finds multiple old volumes.
POSTGRES_VOLUME_NAME=payrollx_postgres_data
# Set to true only after confirming that a new empty database is intended.
# Never use this to replace or recover an existing database volume.
# ALLOW_NEW_DATABASE=true

# Optional host port for the application.
HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=8080
# For a host TLS proxy, bind to 127.0.0.1 and enable proxy headers only after
# confirming the proxy overwrites X-Forwarded-Proto.
TRUST_PROXY_HEADERS=false
