
# Copy to .env and replace every CHANGE_ME value with a unique secret.
POSTGRES_DB=payrollx_salary
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
APP_DB_USER=payrollx_app
APP_DB_PASSWORD=CHANGE_ME_URL_SAFE_APP_DB_PASSWORD
MIGRATOR_DB_USER=payrollx_migrator
MIGRATOR_DB_PASSWORD=CHANGE_ME_MIGRATOR_PASSWORD
ADMIN_USERNAME=Administrator
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD_AT_LEAST_12_CHARACTERS

# Uncomment and set published image references for docker-compose.prod.yml.
# FRONTEND_IMAGE=registry.example.com/payrollx-salary/frontend:latest
# BACKEND_IMAGE=registry.example.com/payrollx-salary/backend:latest
# NGINX_IMAGE=registry.example.com/payrollx-salary/nginx:latest

# Optional host port for Nginx.
HTTP_PORT=8080
